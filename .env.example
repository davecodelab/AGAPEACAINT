# ==========================================
# Agape Academy International - Environment Variables
# ==========================================

# 1. Cloudinary Configuration (Browser & Server)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_upload_preset
# Optional: only needed if using signed uploads or server deletion
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# 2. Supabase Configuration (Database & Media Registry)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Optional: Service role key for admin server operations bypassing RLS
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 3. Admin Authentication Passphrase / Secret
# Master passphrase entered at /admin/login to manage media
ADMIN_SECRET_KEY=agape2026!admin
